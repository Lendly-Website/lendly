# Shared
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lendly
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# The Vite dev server runs on 5175 (5173/5174 are usually taken by other local projects).
WEB_ORIGIN=http://localhost:5175
CLIENT_URL=http://localhost:5175

# Optional image storage. Local uploads are used when these are blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to true to return password reset tokens in development responses so the
# forgot-password flow can be demoed without a mail server.
EXPOSE_RESET_TOKEN=true
